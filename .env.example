# ============================================================================
# TECHPULSE.UZ — MUHIT O'ZGARUVCHILARI (.env.example)
# ============================================================================

# Server va Portlar
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Ma'lumotlar bazasi (PostgreSQL & Prisma ORM)
# Agar tashqi PostgreSQL ishlamayotgan bo'lsa, tizim avtomatik ravishda
# o'rnatilgan PostgreSQL 16 (PGlite ACID Engine) rejimida ./backend/data/pgdata da ishlaydi.
DATABASE_URL="postgresql://techpulse:techpulse_secret_2026@localhost:5432/techpulse_uz?schema=public"
USE_EMBEDDED_POSTGRES=true

# Redis (Kesh va Rate Limiting uchun)
REDIS_URL="redis://localhost:6379"

# JWT va Xavfsizlik Kalitlari
JWT_ACCESS_SECRET="techpulse_uz_super_secret_access_key_2026_uzb"
JWT_REFRESH_SECRET="techpulse_uz_super_secret_refresh_key_2026_uzb"
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"
CSRF_SECRET="techpulse_csrf_protection_secret_2026"

# To'lov Tizimlari (Server-side imzo tekshiruvi uchun maxfiy kalitlar)
CLICK_MERCHANT_ID="click_merchant_uz_001"
CLICK_SERVICE_ID="click_service_uz_001"
CLICK_SECRET_KEY="click_secret_verify_key_2026"

PAYME_MERCHANT_ID="payme_merchant_uz_001"
PAYME_SECRET_KEY="payme_secret_verify_key_2026"

UZUM_MERCHANT_ID="uzum_merchant_uz_001"
UZUM_SECRET_KEY="uzum_secret_verify_key_2026"

# AI Tech Assistant (Modulli AI Provayder Arxitekturasi)
# Provayderlar: "gemini" | "openai" | "hybrid-db"
AI_PROVIDER="hybrid-db"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_DAILY_FREE_LIMIT=500

# Telegram Bot Integratsiyasi
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Cloudinary / Fayl saqlash tizimi
CLOUDINARY_CLOUD_NAME="techpulse-uz"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================================
# ADMIN PANEL LOGIN VA PAROLLARI
# ============================================================================
# 1. Super Admin (Barcha huquqlarga ega: mahsulotlar, buyurtmalar, AI, to'liq sozlamalar)
ADMIN_SUPER_EMAIL="superadmin@techpulse.uz"
ADMIN_SUPER_PASSWORD="Admin@2026!"
ADMIN_SUPER_PHONE="+998900000001"

# 2. Savdo Menejeri (Mahsulotlar, ombor, buyurtmalar, marketing va analitika)
ADMIN_MANAGER_EMAIL="manager@techpulse.uz"
ADMIN_MANAGER_PASSWORD="Manager@2026!"
ADMIN_MANAGER_PHONE="+998900000002"

# 3. Support Operatori (Jonli chat va mijozlar murojaatlari)
ADMIN_SUPPORT_EMAIL="support@techpulse.uz"
ADMIN_SUPPORT_PASSWORD="Support@2026!"
ADMIN_SUPPORT_PHONE="+998900000003"


